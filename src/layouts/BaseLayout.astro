---
import { safeExternalUrl } from '../lib/urls';
import { MAIN_MENU_CATEGORIES, slugifyTaxonomy } from '../lib/taxonomy';
import siteSettings from '../data/site-settings.json';

interface Props {
  title: string;
  description?: string;
  schema?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = 'Violeta Chang: noticias de Chile y el mundo sobre política, economía, ciencia, tecnología, cultura y actualidad.',
  schema,
  canonical,
  ogImage,
  ogType = 'website',
  noindex = false,
} = Astro.props;
const siteOrigin = Astro.site?.href ?? 'https://violetachang.com/';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteOrigin).href;
const socialImageUrl = ogImage ? new URL(ogImage, siteOrigin).href : new URL('/logo.webp', siteOrigin).href;
const youtubeUrl = safeExternalUrl(siteSettings.youtubeUrl);
const tiktokUrl = safeExternalUrl(siteSettings.tiktokUrl);
const whatsappUrl = safeExternalUrl(siteSettings.whatsappUrl);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4B1D91" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Violeta Chang" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Violeta Chang — Veritas Ante Omnia" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    {schema && <script type="application/ld+json" set:html={schema} />}
    <style is:global>
      :root {
        --purple-dark: #4B1D91;
        --purple-mid: #6D28D9;
        --gold: #C7A75E;
        --gold-text: #806000;
        --ink: #1E1B4B;
        --muted: #475569;
        --paper: #FFFFFF;
        --soft: #F8F6FB;
        --border: #E2E8F0;
        --green-wa: #25D366;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: 'Inter', sans-serif;
        line-height: 1.65;
      }
      a { color: inherit; }
      .top-bar {
        min-height: 44px;
        padding: 7px max(20px, calc((100vw - 1200px) / 2));
        background: var(--purple-dark);
        color: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        font-size: .82rem;
      }
      .top-bar strong { color: var(--gold); letter-spacing: .08em; }
      .top-bar__details { color: #F8FAFC; }
      .edition-switch {
        display: inline-flex;
        align-items: center;
        padding: 5px 12px;
        border: 1px solid var(--gold);
        border-radius: 999px;
        color: #fff;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
      }
      .edition-switch:hover { background: var(--gold); color: var(--ink); }
      .site-header {
        max-width: 1240px;
        margin: 0 auto;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 3px solid var(--purple-dark);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        min-width: 230px;
        color: var(--ink);
        text-decoration: none;
      }
      .brand__logo { width: 76px; height: 76px; object-fit: contain; }
      .brand__name {
        margin: 0;
        color: var(--purple-dark);
        font-family: 'Merriweather', Georgia, serif;
        font-size: clamp(1.5rem, 2.3vw, 2rem);
        line-height: 1.15;
      }
      .brand__tagline {
        display: inline-block;
        margin-top: 4px;
        color: var(--gold-text);
        font-size: .76rem;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
      }
      .primary-nav {
        position: sticky;
        top: 0;
        z-index: 20;
        border-bottom: 1px solid var(--border);
        background: rgba(255,255,255,.97);
        backdrop-filter: blur(8px);
      }
      .primary-nav__list {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        gap: 2px;
        overflow-x: auto;
        list-style: none;
        scrollbar-width: thin;
      }
      .primary-nav a {
        display: block;
        padding: 12px 13px;
        color: var(--ink);
        font-size: .87rem;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
      }
      .primary-nav a:hover,
      .primary-nav a:focus-visible { color: var(--purple-dark); box-shadow: inset 0 -3px var(--gold); outline: none; }
      .primary-nav .nav-ads { color: var(--purple-dark); }
      footer {
        margin-top: 52px;
        padding: 38px 20px 18px;
        background: var(--purple-dark);
        color: #F8FAFC;
        font-size: .9rem;
      }
      .footer-grid {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 24px;
      }
      footer h2, footer h3 {
        margin: 0 0 10px;
        color: var(--gold);
        font-size: 1rem;
        text-transform: uppercase;
      }
      footer p { margin: 0; }
      footer a { color: #F8FAFC; text-underline-offset: 3px; }
      footer a:hover { color: var(--gold); }
      .footer-social {
        max-width: 1200px;
        margin: 22px auto 0;
        display: flex;
        flex-wrap: wrap;
        gap: 10px 18px;
      }
      .legal-bottom {
        max-width: 1200px;
        margin: 22px auto 0;
        padding-top: 16px;
        border-top: 1px solid rgba(255,255,255,.22);
        color: #E2E8F0;
        font-size: .8rem;
        text-align: center;
      }
      @media (max-width: 760px) {
        .top-bar { align-items: flex-start; padding: 9px 16px; }
        .site-header { flex-direction: column; align-items: stretch; padding: 16px; }
        .brand { min-width: 0; }
        .primary-nav__list { padding: 0 10px; }
      }
      @media (max-width: 420px) {
        .top-bar { font-size: .74rem; }
        .edition-switch { padding: 4px 9px; }
        .brand__logo { width: 62px; height: 62px; }
      }
    </style>
  </head>
  <body>
    <div class="top-bar">
      <div class="top-bar__details">
        <strong>VERITAS ANTE OMNIA</strong><br />
        Medio de comunicación · Santiago, Chile · <span id="fecha-hoy"></span>
      </div>
      <a class="edition-switch" href="https://violetachang.cl/">Ir a Edición Chile (.cl)</a>
    </div>

    <header class="site-header">
      <a href="/" class="brand" aria-label="Violeta Chang, portada">
        <img class="brand__logo" src="/logo.webp" alt="Emblema de Violeta Chang" width="76" height="76" />
        <span class="brand__text">
          <span class="brand__name">Violeta Chang</span><br />
          <span class="brand__tagline">Veritas Ante Omnia</span>
        </span>
      </a>
    </header>

    <nav class="primary-nav" aria-label="Navegación principal">
      <ul class="primary-nav__list">
        <li><a href="/">Portada</a></li>
        {MAIN_MENU_CATEGORIES.map((category) => (
          <li><a href={`/categorias/${slugifyTaxonomy(category)}/`}>{category}</a></li>
        ))}
        <li><a href="/quienes-somos/">Quiénes somos</a></li>
        <li><a class="nav-ads" href="/#publicidad">Publicidad</a></li>
      </ul>
    </nav>

    <slot />

    <footer>
      <div class="footer-grid">
        <section>
          <h2>Violeta Chang</h2>
          <p><em>Veritas Ante Omnia</em>. Medio de comunicación multiplataforma hecho desde Chile, al servicio de la libertad de prensa y la libertad de expresión.</p>
        </section>
        <section>
          <h2>Contacto y Redacción</h2>
          <p>
            General: <a href="mailto:contacto@violetachang.com">contacto@violetachang.com</a><br />
            Prensa y comunicados: <a href="mailto:prensa@violetachang.com">prensa@violetachang.com</a><br />
            WhatsApp: <a href="https://wa.me/56987167776">+56 9 8716 7776</a>
          </p>
        </section>
        <section>
          <h2>Información legal</h2>
          <p>
            <strong>Directora responsable:</strong> Violeta Chang B.<br />
            <strong>Director suplente:</strong> Eduardo D'Alencon F.<br />
            <strong>Propietario:</strong> Holding Le Merrer Chang SpA<br />
            <strong>RUT:</strong> 78.532.209-6<br />
            <strong>Domicilio:</strong> O'Higgins #220, San Bernardo, RM, Chile.
          </p>
        </section>
      </div>
      <nav class="footer-social" aria-label="Redes sociales">
        <a href="https://www.facebook.com/share/1N7iXwxBrD/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href="https://www.instagram.com/violetachang.cl" target="_blank" rel="noopener noreferrer">Instagram</a>
        {youtubeUrl && <a href={youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube</a>}
        <a href="https://x.com/violetachang?s=11" target="_blank" rel="noopener noreferrer">X</a>
        <a href="https://www.linkedin.com/showcase/violeta-chang/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        {tiktokUrl && <a href={tiktokUrl} target="_blank" rel="noopener noreferrer">TikTok</a>}
        {whatsappUrl && <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Canal de WhatsApp</a>}
        <a href="https://www.lemerrerchang.com" target="_blank" rel="noopener noreferrer">Holding</a>
      </nav>
      <div class="legal-bottom">
        © 2026 Violeta Chang — Medio de comunicación de Holding Le Merrer Chang SpA. Todos los derechos reservados. · <a href="/admin/">Acceso Redacción</a>
      </div>
    </footer>

    <script>
      const dateElement = document.getElementById('fecha-hoy');
      if (dateElement) {
        dateElement.textContent = new Date().toLocaleDateString('es-CL', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
          timeZone: 'America/Santiago',
        });
      }
    </script>
  </body>
</html>
