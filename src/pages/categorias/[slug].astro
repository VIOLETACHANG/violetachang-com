---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { ALL_CATEGORIES, slugifyTaxonomy } from '../../lib/taxonomy';

export async function getStaticPaths() {
  return ALL_CATEGORIES.map((category) => ({
    params: { slug: slugifyTaxonomy(category) },
    props: { category },
  }));
}

const { category } = Astro.props;
const now = new Date();
const articles = (await getCollection('noticias', ({ data }) => data.pubDate <= now))
  .filter((article) => slugifyTaxonomy(article.data.category) === Astro.params.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const description = `Noticias y reportajes de ${category} en Violeta Chang. Información, contexto y actualidad desde Chile.`;
---
<BaseLayout title={`${category} | Violeta Chang`} description={description}>
  <main class="archive">
    <p class="eyebrow">Sección</p>
    <h1>{category}</h1>
    <p class="archive__intro">Noticias, reportajes y análisis sobre {category.toLowerCase()}.</p>
    {articles.length > 0 ? (
      <div class="archive__grid">{articles.map((article) => <NewsCard article={article} />)}</div>
    ) : (
      <div class="archive__empty"><p>Aún no hay noticias publicadas en esta sección.</p><a href="/">Volver a la portada</a></div>
    )}
  </main>
</BaseLayout>

<style>
  .archive { width: min(1200px, calc(100% - 40px)); margin: 36px auto 50px; min-height: 42vh; }
  .eyebrow { margin: 0; color: #806000; font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 4px 0 8px; color: #4B1D91; font-family: 'Merriweather', Georgia, serif; font-size: clamp(2rem, 4vw, 2.7rem); }
  .archive__intro { max-width: 70ch; margin: 0 0 24px; color: #475569; }
  .archive__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .archive__empty { padding: 20px; border: 1px solid #E7E1EF; border-radius: 10px; background: #FBFAFD; }
  .archive__empty a { color: #4B1D91; font-weight: 700; }
  @media (max-width: 900px) { .archive__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .archive { width: calc(100% - 28px); } .archive__grid { grid-template-columns: 1fr; } }
</style>
