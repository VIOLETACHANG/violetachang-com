---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada | Violeta Chang" description="La página solicitada no existe o fue movida." noindex={true}>
  <main class="not-found">
    <p class="not-found__code">404</p>
    <h1>No encontramos esa página</h1>
    <p>Puede que el enlace haya cambiado o que la noticia ya no esté disponible.</p>
    <a href="/">Volver a la portada</a>
  </main>
</BaseLayout>

<style>
  .not-found { width: min(720px, calc(100% - 32px)); min-height: 45vh; margin: 50px auto; padding: 30px; border: 1px solid #E7E1EF; border-radius: 14px; background: #FBFAFD; text-align: center; }
  .not-found__code { margin: 0; color: #806000; font-size: .8rem; font-weight: 800; letter-spacing: .15em; }
  h1 { margin: 6px 0 10px; color: #4B1D91; font-family: 'Merriweather', Georgia, serif; }
  p { color: #475569; }
  a { display: inline-block; margin-top: 12px; padding: 9px 16px; border-radius: 999px; background: #4B1D91; color: #fff; font-weight: 700; text-decoration: none; }
</style>
