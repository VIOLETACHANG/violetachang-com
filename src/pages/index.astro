---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const ahora = new Date();
const todasLasNoticias = await getCollection('noticias', ({ data }) => {
  return data.pubDate <= ahora;
});
const noticias = todasLasNoticias.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const principal = noticias[0];
const secundarias = noticias.slice(1);
---
<BaseLayout title="Violeta Chang | Veritas Ante Omnia — Portal de Noticias">
  <style>
    .container { max-width: 1200px; margin: 25px auto; padding: 0 20px; display: grid; grid-template-columns: 2.3fr 1fr; gap: 30px; }
    @media (max-width: 850px) { .container { grid-template-columns: 1fr; } }
    .hero-news { background: #F8FAFC; border-radius: 12px; overflow: hidden; border: 1px solid #E2E8F0; margin-bottom: 25px; }
    .hero-news img { width: 100%; max-height: 420px; object-fit: cover; }
    .hero-content { padding: 24px; }
    .badge { display: inline-block; background: #4C1D95; color: #FFF; font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 4px; text-transform: uppercase; margin-bottom: 10px; }
    .badge-sponsored { background: #F59E0B; color: #000; margin-left: 6px; }
    .hero-content h2 a { font-family: 'Merriweather', serif; font-size: 1.85rem; color: #1E1B4B; text-decoration: none; }
    .hero-content h2 a:hover { color: #36005B; }
    .meta { font-size: 0.85rem; color: #475569; margin: 10px 0; }
    .news-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    @media (max-width: 600px) { .news-grid { grid-template-columns: 1fr; } }
    .card { border: 1px solid #E2E8F0; border-radius: 10px; padding: 18px; background: #FFF; }
    .card img { width: 100%; height: 180px; object-fit: cover; border-radius: 6px; margin-bottom: 10px; }
    .card h3 a { font-family: 'Merriweather', serif; font-size: 1.15rem; color: #1E1B4B; text-decoration: none; }
    .card h3 a:hover { color: #6D28D9; }
    aside { display: flex; flex-direction: column; gap: 22px; }
    .widget { background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; padding: 18px; }
    .widget h4 { color: #36005B; border-bottom: 2px solid #25D366; padding-bottom: 6px; margin-bottom: 12px; font-size: 1rem; text-transform: uppercase; }
    .ad-box { background: #FFF; border: 1px dashed #94A3B8; height: 250px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 15px; border-radius: 8px; color: #475569; }
    .btn-wa { display: block; background: #01FB01; color: #052E16; font-weight: 800; padding: 10px 16px; border-radius: 8px; text-decoration: none; margin-top: 10px; text-align: center; }
    .mediakit-section { max-width: 1200px; margin: 40px auto; padding: 30px 20px; background: #F5F3FF; border-radius: 12px; border: 1px solid #DDD6FE; }
    .mediakit-section h2 { color: #4C1D95; font-family: 'Merriweather', serif; margin-bottom: 10px; }
    .tarifas-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-top: 18px; }
    .tarifa-card { background: #FFF; padding: 20px; border-radius: 10px; border-top: 4px solid #01FB01; }
  </style>

  <main class="container">
    <section>
      {principal && (
        <article class="hero-news">
          {principal.data.image && <img src={principal.data.image} alt={principal.data.title} />}
          <div class="hero-content">
            <span class="badge">{principal.data.category}</span>
            {principal.data.sponsored && <span class="badge badge-sponsored">Contenido Patrocinado • {principal.data.sponsorName}</span>}
            <h2><a href={`/noticias/${principal.slug}`}>{principal.data.title}</a></h2>
            <div class="meta">Por <strong>{principal.data.author}</strong> {principal.data.authorRole ? `(${principal.data.authorRole})` : ''} • {principal.data.pubDate.toLocaleDateString('es-CL')}</div>
            <p>{principal.data.description}</p>
          </div>
        </article>
      )}

      <div class="news-grid">
        {secundarias.map((item) => (
          <article class="card">
            {item.data.image && <img src={item.data.image} alt={item.data.title} />}
            <span class="badge">{item.data.category}</span>
            {item.data.sponsored && <span class="badge badge-sponsored">Patrocinado</span>}
            <h3><a href={`/noticias/${item.slug}`}>{item.data.title}</a></h3>
            <div class="meta">Por <strong>{item.data.author}</strong> • {item.data.pubDate.toLocaleDateString('es-CL')}</div>
            <p style="font-size:0.92rem;">{item.data.description}</p>
          </article>
        ))}
      </div>
    </section>

    <aside>
      <div class="widget" id="podcast">
        <h4>Podcast &amp; Multimedia</h4>
        <p style="font-size:0.9rem; margin-bottom:10px;">Sigue nuestros titulares en YouTube y cápsulas en TikTok:</p>
        <a href="‎https://whatsapp.com/channel/0029VbE2b9c3QxRujnWkir04" class="btn-wa" target="_blank">Sigue el Canal de WhatsApp del Medio</a>
      </div>

      <div class="widget">
        <h4>Auspiciadores</h4>
        <div class="ad-box">
          <a href="https://www.tiktok.com/@hmb_spa" target="_blank">
  <img src="/banner-hmb.jpg" alt="HMB SPA - BSL SPA" width="300" height="250" style="border-radius: 12px;" />
</a>
          <a href="https://www.electronicaacil.cl" target="_blank">
  <img src="/banner-acil.jpg" alt="ACIL" width="300" height="250" style="border-radius: 12px; margin-top: 12px;" />
</a>
        </div>
      </div>

      <div class="widget">
        <h4>Equipo Editorial</h4>
        <p style="font-size:0.88rem;">
          <strong>Directora:</strong> Violeta Chang <br>
          <strong>Director Suplente:</strong> Eduardo D'Alencon <br>
          <strong>Prensa:</strong> <a href="mailto:prensa@violetachang.com" class="seo-link">prensa@violetachang.com</a>
        </p>
      </div>
    </aside>
  </main>

  <section class="mediakit-section" id="publicidad">
    <h2>Publica y anuncia aquí</h2>
    <p>Posiciona tu empresa u organización en un medio serio, independiente y multiplataforma.</p>
    <div class="tarifas-grid">
      <div class="tarifa-card">
        <h3>Aporte Voluntario (300x30)</h3>
        <p>Apoya con tu aporte aquí cuando quieras.</p>
      </div>
      <div class="tarifa-card">
        <h3>Banner Lateral (300x250)</h3>
        <p>Presencia permanente junto a cada reportaje y crónica.</p>
      </div>
      <div class="tarifa-card">
        <h3> Contenido patrocinado</h3>
        <p>Artículo editorial sobre tu marca con enlaces SEO permanentes e identificación legal.</p>
      </div>
    </div>
    <p style="margin-top:18px;">Solicita nuestro Media Kit y valores a: <a href="mailto:contacto@violetachang.com" class="seo-link">contacto@violetachang.com</a></p>
  </section>
</BaseLayout>
