---
interface Props {
  youtubeUrl?: string;
  tiktokUrl?: string;
  whatsappUrl?: string;
}

const { youtubeUrl, tiktokUrl, whatsappUrl } = Astro.props;
---
<div class="channel-list">
  {youtubeUrl && (
    <a class="channel-card" href={youtubeUrl} target="_blank" rel="noopener noreferrer" aria-label="Visitar el canal de Violeta Chang en YouTube">
      <span class="channel-card__icon channel-card__icon--youtube" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false"><rect x="2" y="5" width="20" height="14" rx="4"></rect><path d="m10 9 5 3-5 3z"></path></svg>
      </span>
      <span><strong>YouTube</strong><small>Noticias y transmisiones</small></span>
      <span class="channel-card__arrow" aria-hidden="true">↗</span>
    </a>
  )}
  {tiktokUrl && (
    <a class="channel-card" href={tiktokUrl} target="_blank" rel="noopener noreferrer" aria-label="Visitar el canal de Violeta Chang en TikTok">
      <span class="channel-card__icon channel-card__icon--tiktok" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false"><path d="M15 3v10.7a4.3 4.3 0 1 1-3.1-4.1v3.2a1.3 1.3 0 1 0 .1.4V3h3c.2 2.2 1.5 3.7 3.8 4v3.1A8 8 0 0 1 15 8.8"></path></svg>
      </span>
      <span><strong>TikTok</strong><small>Cápsulas informativas</small></span>
      <span class="channel-card__arrow" aria-hidden="true">↗</span>
    </a>
  )}
  {whatsappUrl && <a class="whatsapp-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Seguir el canal de WhatsApp</a>}
</div>

<style>
  .channel-list { display: grid; gap: 10px; }
  .channel-card {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    border: 1px solid #E6E0EF;
    border-radius: 10px;
    background: #fff;
    color: #1E1B4B;
    text-decoration: none;
    transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease;
  }
  .channel-card:hover { border-color: #C7A75E; box-shadow: 0 6px 18px rgba(30,27,75,.08); transform: translateY(-1px); }
  .channel-card:focus-visible, .whatsapp-link:focus-visible { outline: 3px solid #C7A75E; outline-offset: 3px; }
  .channel-card__icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; }
  .channel-card__icon svg { width: 25px; height: 25px; }
  .channel-card__icon--youtube { background: #FCEBEC; }
  .channel-card__icon--youtube svg { fill: #C62828; }
  .channel-card__icon--youtube svg path { fill: #fff; }
  .channel-card__icon--tiktok { background: #EEF0F4; }
  .channel-card__icon--tiktok svg { fill: #111; }
  .channel-card strong, .channel-card small { display: block; }
  .channel-card strong { font-size: .94rem; }
  .channel-card small { margin-top: 1px; color: #64748B; font-size: .76rem; }
  .channel-card__arrow { color: #806000; font-weight: 800; }
  .whatsapp-link { display: inline-block; margin-top: 2px; color: #285A3D; font-size: .84rem; font-weight: 700; text-underline-offset: 3px; }
</style>
