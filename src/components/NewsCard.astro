---
import type { CollectionEntry } from 'astro:content';
import { articleImageUrl } from '../lib/images';
import { articlePath } from '../lib/article-url';
import { slugifyTaxonomy } from '../lib/taxonomy';
import { safeExternalUrl } from '../lib/urls';

interface Props {
  article: CollectionEntry<'noticias'>;
}

const { article } = Astro.props;
const data = article.data;
const author = data.author?.trim() || 'Redacción';
const authorProfile = safeExternalUrl(data.authorUrl);
const articleHref = articlePath(article.slug, data.urlSlug);
const image = articleImageUrl(data.image, 'card');
const mobileImage = data.imageMobile
  ? articleImageUrl(data.imageMobile, 'source')
  : articleImageUrl(data.image, 'cardMobile');
---
<article class="news-card">
  {image && <a class="news-card__image-link" href={articleHref} aria-label={`Leer: ${data.title}`}><picture><source media="(max-width: 640px)" srcset={mobileImage} /><img class="news-card__image" src={image} alt={data.title} width="640" height="360" loading="lazy" /></picture></a>}
  <div class="news-card__content">
    <div class="news-card__badges">
      <a class="news-card__category" href={`/categorias/${slugifyTaxonomy(data.category)}/`}>{data.category}</a>
      {data.es_comunicado && <span class="news-card__badge">Comunicado</span>}
      {data.sponsored && <span class="news-card__badge news-card__badge--sponsored">Patrocinado</span>}
    </div>
    <h2 class="news-card__title"><a href={articleHref}>{data.title}</a></h2>
    <p class="news-card__summary">{data.description}</p>
    <p class="news-card__meta">
      {authorProfile ? <a href={authorProfile} target="_blank" rel="noopener noreferrer">{author}</a> : author}
      <span aria-hidden="true"> · </span>
      <time datetime={data.pubDate.toISOString()}>{data.pubDate.toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Santiago' })}</time>
    </p>
    {data.tags?.length > 0 && (
      <ul class="news-card__tags" aria-label="Etiquetas">
        {data.tags.slice(0, 3).map((tag) => <li><a href={`/etiquetas/${slugifyTaxonomy(tag)}/`}>{tag}</a></li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .news-card { overflow: hidden; border: 1px solid #E7E1EF; border-radius: 12px; background: #fff; box-shadow: 0 2px 10px rgba(30,27,75,.035); }
  .news-card__image-link { display: block; overflow: hidden; background: #F8F6FB; }
  .news-card__image { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; transition: transform .25s ease; }
  .news-card__image-link:hover .news-card__image { transform: scale(1.025); }
  .news-card__content { padding: 16px; }
  .news-card__badges { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 9px; }
  .news-card__category, .news-card__badge { display: inline-flex; padding: 3px 8px; border-radius: 999px; background: #F1EAFB; color: #4B1D91; font-size: .7rem; font-weight: 800; text-decoration: none; text-transform: uppercase; }
  .news-card__badge { background: #EEF0F4; color: #334155; }
  .news-card__badge--sponsored { background: #F4E6C4; color: #5B4300; }
  .news-card__title { margin: 0; font-family: 'Merriweather', Georgia, serif; font-size: 1.18rem; line-height: 1.4; }
  .news-card__title a { color: #1E1B4B; text-decoration: none; }
  .news-card__title a:hover { color: #4B1D91; text-decoration: underline; text-decoration-color: #C7A75E; text-underline-offset: 4px; }
  .news-card__summary { margin: 9px 0; color: #475569; font-size: .91rem; }
  .news-card__meta { margin: 0; color: #64748B; font-size: .78rem; }
  .news-card__meta a { color: #4B1D91; font-weight: 700; }
  .news-card__tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 11px 0 0; padding: 0; list-style: none; }
  .news-card__tags a { color: #5B4300; font-size: .73rem; text-decoration: underline; text-decoration-color: #C7A75E; text-underline-offset: 3px; }
  @media (max-width: 640px) { .news-card__image { aspect-ratio: 4 / 5; } }
</style>
