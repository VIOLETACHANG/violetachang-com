---
interface Props {
  title: string;
  description?: string;
  schema?: string;
}

const {
  title,
  description = "Violeta Chang — Veritas Ante Omnia. Medio de comunicación multiplataforma hecho desde Chile al servicio de la libertad de prensa y la libertad de expresión. Holding Le Merrer Chang SpA.",
  schema
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://googleapis.com">
  <link href="https://googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  {schema && <script type="application/ld+json" set:html={schema} />}
  <style is:global>
    :root {
      --bg-main: #FFFFFF;
      --bg-soft: #F8FAFC;
      --text-ink: #1E1B4B;
      --purple-dark: #4C1D95;
      --purple-mid: #6D28D9;
      --green-wa: #25D366;
      --green-dark: #15803D;
      --border-light: #E2E8F0;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg-main);
      color: var(--text-ink);
      font-family: 'Inter', sans-serif;
      line-height: 1.7;
    }
    /* Enlaces SEO internos y externos resaltados en verde */
    .article-body a, .seo-link {
      color: var(--green-dark);
      font-weight: 700;
      text-decoration: underline;
      text-decoration-color: var(--green-wa);
      text-decoration-thickness: 2px;
    }
    .article-body a:hover, .seo-link:hover { background-color: #DCFCE7; }

    .top-bar {
      background: var(--purple-dark);
      color: #FFFFFF;
      font-size: 0.85rem;
      padding: 8px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }
    .top-bar .edition-switch {
      background: var(--green-wa);
      color: #052E16;
      font-weight: 800;
      padding: 4px 12px;
      border-radius: 20px;
      text-decoration: none;
      font-size: 0.8rem;
    }
    .social-links a {
      color: #FFFFFF;
      text-decoration: none;
      margin-left: 12px;
      font-weight: 600;
    }
    .social-links a:hover { color: var(--green-wa); }

    header {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 3px solid var(--purple-dark);
      flex-wrap: wrap;
      gap: 15px;
    }
    .brand { display: flex; align-items: center; gap: 15px; text-decoration: none; color: var(--text-ink); }
    .brand img { width: 78px; height: 78px; object-fit: contain; }
    .brand-text h1 { font-family: 'Merriweather', serif; font-size: 2rem; color: var(--purple-dark); line-height: 1.1; }
    .brand-text span { font-size: 0.85rem; font-weight: 700; letter-spacing: 2px; color: var(--green-dark); text-transform: uppercase; }

    .ad-leaderboard {
      background: var(--bg-soft);
      border: 1px dashed #CBD5E1;
      padding: 12px 20px;
      text-align: center;
      font-size: 0.8rem;
      color: #64748B;
      border-radius: 8px;
      min-width: 300px;
    }

    nav {
      background: var(--bg-soft);
      border-bottom: 1px solid var(--border-light);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    nav ul {
      max-width: 1200px;
      margin: 0 auto;
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      padding: 0 20px;
    }
    nav ul li a {
      display: block;
      padding: 12px 16px;
      text-decoration: none;
      color: var(--text-ink);
      font-weight: 700;
      font-size: 0.92rem;
    }
    nav ul li a:hover { color: var(--purple-mid); border-bottom: 3px solid var(--green-wa); }
    nav ul li a.nav-ads { color: var(--purple-dark); background: #EDE9FE; }

    footer {
      background: var(--purple-dark);
      color: #F8FAFC;
      padding: 40px 20px;
      margin-top: 50px;
      font-size: 0.9rem;
    }
    .footer-grid {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 25px;
    }
    footer h5 { color: var(--green-wa); font-size: 1rem; margin-bottom: 10px; text-transform: uppercase; }
    footer a { color: #E2E8F0; text-decoration: none; }
    footer a:hover { color: var(--green-wa); }
    .legal-bottom {
      max-width: 1200px;
      margin: 25px auto 0;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,0.2);
      font-size: 0.82rem;
      color: #CBD5E1;
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="top-bar">
    <div>
      <strong>VERITAS ANTE OMNIA</strong> • Santiago, Chile • <span id="fecha-hoy"></span>
    </div>
    <div class="social-links">
      <a href="/#podcast">YouTube</a>
      <a href="/#podcast">TikTok</a>
      <a href="https://wa.me" target="_blank">WhatsApp</a>
      <a href="https://violetachang.cl" class="edition-switch" target="_blank">Ir a Edición Chile (.cl) →</a>
    </div>
  </div>

  <header>
    <a href="/" class="brand">
      <img src="/logo.png" alt="Logotipo Violeta Chang" onerror="this.style.display='none'">
      <div class="brand-text">
        <h1>Violeta Chang</h1>
        <span>Veritas Ante Omnia • Medio Multiplataforma</span>
      </div>
    </a>
    <div class="ad-leaderboard">
      <strong>ESPACIO AUSPICIADOR PRINCIPAL (728x90)</strong><br>
      <a href="/#publicidad" class="seo-link">Anuncia tu marca aquí</a>
    </div>
  </header>

  <nav>
    <ul>
      <li><a href="/">Portada</a></li>
      <li><a href="/#chile">Chile</a></li>
      <li><a href="/#actualidad">Actualidad</a></li>
      <li><a href="/#cultura">Cultura y Eventos</a></li>
      <li><a href="/#deportes">Deportes</a></li>
      <li><a href="/#podcast">Podcast &amp; Multimedia</a></li>
      <li><a href="/#opinion">Opinión</a></li>
      <li><a href="/#publicidad" class="nav-ads">Publicidad / Tarifas</a></li>
    </ul>
  </nav>

  <slot />

  <footer>
    <div class="footer-grid">
      <div>
        <h5>Violeta Chang</h5>
        <p><em>Veritas Ante Omnia</em>. Medio de comunicación multiplataforma hecho desde Chile, al servicio de la libertad de prensa y la libertad de expresión.</p>
      </div>
      <div>
        <h5>Contacto y Redacción</h5>
        <p>
          General: <a href="mailto:contacto@violetachang.com">contacto@violetachang.com</a><br>
          Prensa y Comunicados: <a href="mailto:prensa@violetachang.com">prensa@violetachang.com</a><br>
          WhatsApp: <a href="https://wa.me">+56 9 8716 7776</a>
        </p>
      </div>
      <div>
        <h5>Información Legal</h5>
        <p>
          <strong>Directora Responsable:</strong> Violeta Chang B.<br>
          <strong>Director Suplente:</strong> Eduardo D'Alencon F.<br>
          <strong>Propietario:</strong> Holding Le Merrer Chang SpA<br>
          <strong>RUT:</strong> 78.532.209-6<br>
          <strong>Domicilio:</strong> O'Higgins #220, San Bernardo, RM, Chile.
        </p>
      </div>
    </div>
    <div class="legal-bottom">
      ©️ 2026 Violeta Chang — Medio de comunicación de Holding Le Merrer Chang SpA. Todos los derechos reservados. | <a href="/admin/">Acceso Redacción</a>
    </div>
  </footer>

  <script>
    const opciones: Intl.DateTimeFormatOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
    const el = document.getElementById('fecha-hoy');
    if (el) el.textContent = new Date().toLocaleDateString('es-CL', opciones);
  </script>
</body>
</html>
